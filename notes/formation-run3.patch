-SHAPE_NAMES = ("advance", "forward_speed", "length", "width", "in_opp_half")
+BASE_NAMES = ("advance", "forward_speed", "length", "width", "in_opp_half", "space", "line")
+ROLL_S = (1.0, 3.0)
+SHAPE_NAMES = BASE_NAMES + tuple("{}_{:g}s".format(nm, r) for r in ROLL_S for nm in BASE_NAMES)
+_CHUNK = 20000   # frames per block of the player-to-opponent distance matrix
+
+
+def _space(xc, yc, c, o):
+    """(n,) mean over team c's players of the distance to the nearest player of team o."""
+    out = np.full(len(xc), np.nan)
+    if not (len(c) and len(o)):
+        return out
+    for a in range(0, len(xc), _CHUNK):
+        b = a + _CHUNK
+        d = np.hypot(xc[a:b, c, None] - xc[a:b, None, o], yc[a:b, c, None] - yc[a:b, None, o])
+        out[a:b] = np.nanmean(np.nanmin(d, axis=2), axis=1)
+    return out
+
 
+def _rolling(a, k):
+    """Centred moving mean of each column of a over k frames, shorter at the ends."""
+    box = np.ones(max(1, min(k, len(a))))   # "same" returns the longer of the two lengths
+    den = np.convolve(np.ones(len(a)), box, mode="same")
+    return np.stack([np.convolve(col, box, mode="same") / den for col in a.T], axis=1)
 
